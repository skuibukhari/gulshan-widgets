<?xml version="1.0" encoding="utf-8"?>
<!-- Widget login configuration screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/widget_bg_dept">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐 ویجٹ لاگ اِن"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="اپنے ڈیپارٹمنٹ کا یوزر نیم اور پاس ورڈ لکھیں — ویجٹ خود live ڈیٹا لے گا"
        android:textColor="#BBDEFB"
        android:textSize="14sp"
        android:gravity="center" />

    <EditText
        android:id="@+id/et_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="یوزر نیم"
        android:textColor="#FFFFFF"
        android:textColorHint="#90CAF9"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="پاس ورڈ"
        android:textColor="#FFFFFF"
        android:textColorHint="#90CAF9"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="#FF8A80"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="لاگ اِن کریں" />
</LinearLayout>
